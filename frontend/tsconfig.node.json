{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    // DOM, because a Playwright `page.evaluate` callback is serialised and
    // run IN THE BROWSER even though it is written in a Node-side file. The
    // flows measure layout that way -- jsdom applies no media queries and
    // measures nothing, so a responsive regression can only be caught here.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
