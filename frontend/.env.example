# Frontend configuration. Copy to `.env` (git-ignored).
# Every VITE_* variable is embedded in the public JS bundle:
# NEVER put secrets here.
# Locally: the API on its own port.
VITE_API_BASE_URL=http://localhost:8000

# Deployed: a path prefix means "same origin", which is what the Netlify
# proxy in netlify.toml provides. netlify.toml already sets this to "/", so
# the browser talks to one origin and the refresh cookie stays first-party.
