# ---------------------------------------------------------------------------
# LPU Research Hub - backend configuration
# Copy to `.env` (which is git-ignored) and replace the placeholder values.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development

# SQLAlchemy URL. The `postgresql+psycopg` driver prefix is required.
DATABASE_URL=postgresql+psycopg://lpu_hub:CHANGE_ME@localhost:5432/lpu_research_hub

# Separate database used by `pytest -m db`. Leave unset to skip DB tests.
TEST_DATABASE_URL=postgresql+psycopg://lpu_hub:CHANGE_ME@localhost:5432/lpu_research_hub_test

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Connection pool and timeout (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=5
