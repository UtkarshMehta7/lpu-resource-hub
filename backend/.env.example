# ---------------------------------------------------------------------------
# LPU Research Hub - backend configuration
# Copy to `.env` (which is git-ignored) and replace the placeholder values.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development

# SQLAlchemy URL. The `postgresql+psycopg` driver prefix is required.
DATABASE_URL=postgresql+psycopg://lpu_hub:CHANGE_ME@localhost:5432/lpu_research_hub

# Separate database used by `pytest -m db`. Leave unset to skip DB tests.
TEST_DATABASE_URL=postgresql+psycopg://lpu_hub:CHANGE_ME@localhost:5432/lpu_research_hub_test

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Connection pool and timeout (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=5

# Signs access-token JWTs. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARACTERS

# Access token lifetime in minutes, refresh token lifetime in days (optional)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# lax | strict | none. Use "none" (with HTTPS) only when the frontend and
# backend are on different domains, e.g. a cross-domain production deploy.
REFRESH_COOKIE_SAMESITE=lax
